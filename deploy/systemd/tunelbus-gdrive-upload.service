[Unit]
Description=Tunelbus upload verified daily backup to Google Drive
Wants=network-online.target
After=network-online.target tunelbus-backup-daily.service

[Service]
Type=oneshot
User=anlex
Group=anlex
SupplementaryGroups=tunelbus
UMask=0077
ExecStart=/usr/bin/bash /srv/anlex/tunelbus/scripts/upload-daily-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# Permit rclone to persist refreshed OAuth tokens in its private configuration.
ReadWritePaths=/home/anlex/.config/rclone
