[Unit]
Description=Tunelbus trolleybus raw realtime collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anlex
WorkingDirectory=/srv/anlex/tunelbus-trolleybus
EnvironmentFile=/srv/anlex/tunelbus/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/anlex/tunelbus/.venv/bin/python -m app.trolleybus collect --db /srv/anlex/tunelbus-trolleybus/data/trolleybus.sqlite3 --routes 51,52,53,58 --interval 30
Restart=always
RestartSec=15
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
